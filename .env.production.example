# Copie esse arquivo para .env na pasta de deploy da VPS
# (ex: /opt/camisaria/.env) e ajuste os valores.

DB_NAME=ecommerce
DB_USER=ecommerce
# Use uma senha forte em producao
DB_PASS=trocar-em-producao

# Gere com: openssl rand -hex 32
JWT_SECRET=trocar-em-producao

# Opcional: porta publica do frontend (default 80)
FRONTEND_PORT=80

# As variaveis abaixo sao opcionais — o deploy.yml seta elas em build time.
# Se quiser fixar uma tag manualmente (rollback), descomente:
# BACKEND_IMAGE=ghcr.io/leonardogalvaotoffoli/ecommerce-api-backend:latest
# FRONTEND_IMAGE=ghcr.io/leonardogalvaotoffoli/ecommerce-api-frontend:latest
